{
  "name": "cjs-escala",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "dev": "node scripts/serve.js",
    "build": "node scripts/build.js",
    "test:browser": "npm run build && node tests/browser.cjs",
    "test:auth:browser": "npm run build && node tests/browser-auth.cjs",
    "test:persistence": "node scripts/test-persistence.mjs",
    "start": "node scripts/start.js",
    "test:identity:browser": "npm run build && node scripts/test-persistence.mjs --browser"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  },
  "dependencies": {
    "@e965/xlsx": "0.20.3",
    "@vercel/functions": "3.10.3"
  }
}
