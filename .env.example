# Obrigatório na Vercel. Gere um valor aleatório: openssl rand -hex 32
# Cadastre em Settings > Environment Variables e refaça o deploy.
AUTH_SESSION_SECRET=

# Habilitar após aplicar as migrações e homologar o login individual n8n.
PERSISTENCE_ENABLED=false
# Instância dedicada de PostgREST deste produto, opcionalmente publicada sob subcaminho.
PERSISTENCE_RPC_URL=https://api.exemplo.invalid/escala
# Chave própria deste produto, igual à do PostgREST. Nunca reutilizar a senha do banco.
PERSISTENCE_JWT_SECRET=
# Somente para testes locais em loopback; manter false na hospedagem.
PERSISTENCE_ALLOW_LOCAL_HTTP=false

# Ativar somente depois de aplicar 002_individual_sessions.sql e homologar o fluxo n8n.
AUTH_MODE=shared
# Origem pública canônica. Obrigatória em npm start na VPS; evita confiar em Host/Forwarded.
APP_ORIGIN=
# URL de produção do NOVO webhook, sem parâmetros ou credenciais no endereço.
N8N_LOGIN_URL=https://n8n.exemplo.invalid/webhook/cjs/auth/login
# Credencial Header Auth do n8n: nome X-CJS-Service-Key. Chave aleatória >=32 caracteres.
N8N_SERVICE_SECRET=
# Chave de assinatura do JWT de identidade, diferente da chave de RPC e da chave do cookie.
N8N_JWT_SECRET=
N8N_JWT_ISSUER=fintria-cjs-identity
N8N_JWT_AUDIENCE=fintria-cjs-login
